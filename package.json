{
  "name": "sevari-core",
  "private": true,
  "version": "0.1.0",
  "description": "Sevari BDI — the operations layer for service businesses. Build contract: docs/BUILD_CONTRACT.md",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:gate": "node scripts/run-gate.mjs",
    "test:all": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "db:local": "bash scripts/local-postgres.sh",
    "register:generate": "tsx scripts/generate-processor-register.ts",
    "contract:status": "tsx scripts/contract-status.ts",
    "eval": "tsx eval/run.ts",
    "secrets:scan": "gitleaks detect --no-banner --redact --config .gitleaks.toml",
    "check": "pnpm typecheck && pnpm lint && pnpm test:gate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.3.0",
    "testcontainers": "11.7.2",
    "@testcontainers/postgresql": "11.7.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.7"
  }
}
