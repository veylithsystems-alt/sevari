{
  "name": "sevari-core",
  "private": true,
  "version": "0.1.0",
  "description": "Sevari BDI \u2014 the operations layer for service businesses. Build contract: docs/BUILD_CONTRACT.md",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:gate": "node scripts/run-gate.mjs",
    "test:all": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "db:local": "bash scripts/local-postgres.sh",
    "register:generate": "tsx scripts/generate-processor-register.ts",
    "contract:status": "tsx scripts/contract-status.ts",
    "eval": "node eval/run.ts",
    "secrets:scan": "gitleaks detect --no-banner --redact --config .gitleaks.toml",
    "check": "pnpm typecheck && pnpm lint && pnpm test:gate",
    "models:bench": "node eval/models/bench.ts",
    "models:registry": "node scripts/model-registry.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@sevari/accounts": "workspace:*",
    "@sevari/api": "workspace:*",
    "@sevari/approvals": "workspace:*",
    "@sevari/audit": "workspace:*",
    "@sevari/autonomy": "workspace:*",
    "@sevari/boot": "workspace:*",
    "@sevari/channels": "workspace:*",
    "@sevari/clock": "workspace:*",
    "@sevari/crypto": "workspace:*",
    "@sevari/db": "workspace:*",
    "@sevari/domain": "workspace:*",
    "@sevari/egress": "workspace:*",
    "@sevari/finance": "workspace:*",
    "@sevari/grounding": "workspace:*",
    "@sevari/hitl": "workspace:*",
    "@sevari/identity": "workspace:*",
    "@sevari/intake": "workspace:*",
    "@sevari/knowledge": "workspace:*",
    "@sevari/lifecycle": "workspace:*",
    "@sevari/llm": "workspace:*",
    "@sevari/metrics": "workspace:*",
    "@sevari/onboarding": "workspace:*",
    "@sevari/outbound": "workspace:*",
    "@sevari/privacy": "workspace:*",
    "@sevari/region": "workspace:*",
    "@sevari/templates": "workspace:*",
    "@sevari/verticals": "workspace:*",
    "@sevari/worker": "workspace:*",
    "@testcontainers/postgresql": "11.7.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.3.0",
    "pg": "8.16.3",
    "testcontainers": "11.7.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.7",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
